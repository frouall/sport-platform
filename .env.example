# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose it to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI assistant (free tier). Leave empty to use the form fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
